{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theodb.dev/schemas/statistics.schema.json",
  "title": "Derived statistics",
  "description": "Aggregation across repetitions. Every repetition is retained upstream; nothing here removes a run, and any outlier policy is named and versioned rather than applied silently.",
  "type": "object",
  "required": ["schema_version", "run_id", "points"],
  "additionalProperties": false,
  "$defs": {
    "absent": {
      "type": "object",
      "required": ["absent"],
      "additionalProperties": false,
      "properties": {
        "absent": { "type": "string", "enum": ["unsupported", "unavailable", "not_collected", "invalid"] },
        "detail": { "type": "string" }
      }
    },
    "maybe_number": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/absent" }] },
    "aggregate": {
      "type": "object",
      "required": ["median", "repetitions"],
      "additionalProperties": false,
      "properties": {
        "median": { "$ref": "#/$defs/maybe_number" },
        "mean": { "$ref": "#/$defs/maybe_number" },
        "stdev": { "$ref": "#/$defs/maybe_number" },
        "min": { "$ref": "#/$defs/maybe_number" },
        "max": { "$ref": "#/$defs/maybe_number" },
        "coefficient_of_variation": { "$ref": "#/$defs/maybe_number" },
        "ci95_low": { "$ref": "#/$defs/maybe_number" },
        "ci95_high": { "$ref": "#/$defs/maybe_number" },
        "repetitions": { "type": "integer", "minimum": 1 },
        "values": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Every retained repetition value, in repetition order."
        }
      }
    }
  },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string" },
    "outlier_policy": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "enum": ["none", "documented"] },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["point", "repetition", "reason"],
            "additionalProperties": false,
            "properties": {
              "point": { "type": "string" },
              "repetition": { "type": "integer" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "metrics"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "parameters": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/aggregate" }
          },
          "stability": {
            "type": "object",
            "required": ["stable"],
            "additionalProperties": false,
            "properties": {
              "stable": { "type": "boolean" },
              "reason": { "type": "string" },
              "threshold_cv": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
